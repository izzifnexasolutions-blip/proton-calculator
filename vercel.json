{
  "buildCommand": "echo 'FARIS static public build: no npm needed'",
  "installCommand": "echo 'FARIS static deploy: skip npm install'",
  "outputDirectory": "public",
  "framework": null,
  "routes": [
    {
      "src": "/",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      },
      "dest": "/calculator.html"
    },
    {
      "src": "^/studio3d/?$",
      "dest": "/studio3d/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
